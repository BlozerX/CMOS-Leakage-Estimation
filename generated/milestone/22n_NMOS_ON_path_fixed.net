*CONDUCTION NMOS W1

*.INCLUDE /home/anto/Documents/dvd_M24/model/22nm_MGK.pm
.include "../../model/model/22nm_MGK.pm"
*.INCLUDE ../../model/22nm_MGK.pm
.OPTIONS GMIN=1e-020 ABSTOL=1e-18

*Definitions of Parameters
.PARAM Lmin=22n
.PARAM Wmin=22n
.PARAM Ldiff=44n
	
*Cell/Device description
Mn drain gate source body nmos W={Wmin} L={Lmin} 
Vd 	drain	0		0
Vg 	gate	Ref		0
Vs 	source	0		0
Vb 	body	0		0
Vdd 	Ref	0		0

*Definition of type of analysis
.CONTROL
set width=240
set numdgt=15
set wr_singlescale
set wr_vecnames
let voltage=0
let Vddbasic=1.2
while voltage le Vddbasic
  let voltage = voltage + 0.05
  alter Vdd = voltage
  dc TEMP 30 90 60
  print abs(V(Ref)) V(drain) V(gate) V(source) V(body) I(Vd) I(Vg) I(Vs) I(Vb)
  wrdata legacy.dat v(ref) v(drain) v(gate) v(source) v(body) i(vd) i(vg) i(vs) i(vb)
  set appendwrite
end
show mn
showmod mn
quit
.ENDC
.END
